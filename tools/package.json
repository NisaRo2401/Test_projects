{
  "name": "ihk-exam-import",
  "version": "1.0.0",
  "description": "PDF-Extraktion + Supabase-Import für IHK-Exam-Trainer (ohne API-Kosten)",
  "type": "module",
  "private": true,
  "scripts": {
    "extract": "node extract-pdf.mjs",
    "ocr": "node ocr-extract.mjs",
    "insert": "node insert-questions.mjs",
    "check": "node --check extract-pdf.mjs && node --check ocr-extract.mjs && node --check insert-questions.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "0.1.100",
    "@supabase/supabase-js": "2.112.2",
    "dotenv": "16.6.1",
    "pdfjs-dist": "4.10.38",
    "tesseract.js": "7.0.0"
  }
}
